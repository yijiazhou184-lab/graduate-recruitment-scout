{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/graduate-recruitment-scout/job-record.schema.json",
  "title": "Graduate Recruitment Scout Job Record",
  "type": "object",
  "required": ["record_id", "company", "role_title", "application_status", "verification_status", "source_type", "source_url", "first_seen", "last_verified", "change_type"],
  "properties": {
    "record_id": {"type": "string", "pattern": "^job_[0-9a-f]{16}$"},
    "company": {"type": "string", "minLength": 1},
    "role_title": {"type": "string", "minLength": 1},
    "normalized_role_title": {"type": "string"},
    "match_score": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
    "application_status": {"enum": ["eligible", "pending_verification", "ineligible", "closed", "offline"]},
    "verification_status": {"enum": ["verified", "partially_verified", "unverified", "blocked"]},
    "page_status": {"enum": ["active", "closed", "removed", "blocked", "login_required", "unknown", ""]},
    "source_type": {"enum": ["official_employer", "official_ats", "trusted_job_board", "community_lead", "search_engine"]},
    "source_url": {"type": "string", "format": "uri"},
    "official_source_url": {"type": "string"},
    "apply_url": {"type": "string"},
    "first_seen": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}(-[0-9]{2})?$"},
    "last_verified": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}(-[0-9]{2})?$"},
    "source_checked_at": {"type": "string"},
    "change_type": {"enum": ["new", "updated", "deadline_soon", "closed", "offline", "unchanged"]}
  }
}
